<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 只为了 UI Automation 客户端（System.Windows.Automation，UiAutomationTests 用它像读屏软件一样遍历界面） -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF 会去掉隐式的 System.IO（避免和 System.Windows.Shapes.Path 冲突），这里不用 WPF 的形状，加回来 -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DiskThinner.App\DiskThinner.App.csproj" />
  </ItemGroup>
</Project>
