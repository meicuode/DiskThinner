<Project>
  <!-- 集中管理依赖版本。所有版本固定，升级单独提交。 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- 规则库与快照：SQLite -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- 只在 dtrule（规则维护工具）里使用 -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- 只在 tools/i18n（界面文字的改写和 resx 生成）里使用，不进产品 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <!-- 写入监控（阶段 2a）：只在 DiskThinner.Monitor.Etw 和 spikes/EtwBench 里使用，2b 的常驻服务改为直接调用 ETW API -->
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 仅测试项目使用 -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
