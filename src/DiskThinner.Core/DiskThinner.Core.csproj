<Project Sdk="Microsoft.NET.Sdk">
  <!-- 领域模型与通用工具。不引用 WinForms，按 Native AOT 要求编写。 -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- 界面文字的中性语言：Strings.resx 里是中文原文，译文放在 Strings.<语言>.resx（见 L.cs） -->
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>
</Project>
